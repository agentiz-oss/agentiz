[Unit]
Description=Agentiz OpenHands worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=agentiz-worker
Group=agentiz-worker
ExecStart=/opt/agentiz-worker/venv/bin/agentiz-worker run --config %h/.config/agentiz/worker.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
