# Public Agentiz Worker API address; no database credentials belong here.
AGENTIZ_WORKER_API_URL=https://agentiz.example.com/api/agentiz/worker/v1
AGENTIZ_WORKER_TOKEN=replace-with-token-shown-once-in-agentiz-panel
AGENTIZ_WORKER_ID=worker-01
AGENTIZ_WORKER_WORKSPACE=/srv/agentiz-fixtures
# amd64 image used by the stage-0 smoke. Replace with the approved image digest on release.
AGENTIZ_OPENHANDS_SERVER_IMAGE=ghcr.io/openhands/agent-server:1.40.0-python-amd64@sha256:b2326ac6d444f3f80f2fa3260ab21653a9b6dfd02d5331643921428d79b87cc6
OPENHANDS_SUPPRESS_BANNER=1
