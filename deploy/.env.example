# Пример .env для запуска с PostgreSQL
# DB_DIALECT=postgres
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=postgres
# DB_NAME=postgres

# Development environment configuration
PORT=17280
NODE_ENV=production

# Секреты. Значений по умолчанию нет — сгенерируй свои, например `openssl rand -hex 32`,
# и держи их только в .env.local (он в .gitignore).
JWT_SECRET=
WORKER_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
# Адрес прокси Telegram API, если используется
TELEGRAM_API_BASE_URL=
TELEGRAM_API_SECRET=

# Агентный воркер
WORKER_IMAGE=
WORKER_QUEUE_SERVER_URL=http://server:17280
WORKER_ID=dev
WORKER_POLL_INTERVAL_MS=3000
WORKER_DRY_RUN=true
