{
  "name": "app-migrate-generator",
  "version": "1.0.0",
  "description": "CLI to generate SQL migrations for an Agentiz app",
  "type": "module",
  "main": "dist/fixture/index.js",
  "bin": {
    "app-migrate-generator": "bin/generate-migration-wrapper.mjs",
    "migrate-generator": "bin/generate-migration-wrapper.mjs"
  },
  "files": [
    "dist",
    "bin",
    "lib",
    "fixture",
    "README.md",
    "package.json",
    "!**/.atlas"
  ],
  "scripts": {
    "test": "vitest",
    "dev": "tsx watch ./fixture/index.ts",
    "build": "tsc && cp package.json dist/",
    "prepublishOnly": "npm run build",
    "fixture": "tsx ./fixture/index.ts",
    "migrate": "tsx ./bin/generate-migration.ts",
    "migrate:docker": "./scripts/run-in-docker.sh",
    "docker:build": "docker build -t agentiz-migrations .",
    "docker:run": "docker run --rm -v $(pwd):/workspace -v /var/run/docker.sock:/var/run/docker.sock --network host agentiz-migrations"
  },
  "dependencies": {
    "@nodeknit/app-manager": "file:../../local_modules/app-manager",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6",
    "sqlite3": "^5.1.7",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
