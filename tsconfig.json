{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "sourceMap": false,
    // This is an application, not a published library: `npm run build` is `tsc --noEmit`, the image
    // builds with `vite build`, and package.json declares no `types`. The only thing `declaration`
    // did here was demand that every public API be *emittable* as a .d.ts, which sequelize model
    // shapes are not — 20 TS4050s across app-agentiz-mobile-api, invisible until now only because
    // earlier errors stopped tsc before declaration checking. Turn it back on if a layer is ever
    // published on its own, and annotate those return types then.
    "declaration": false,
    "removeComments": false,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "alwaysStrict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "lib": ["dom", "esnext"],
    "paths": {
      "@/components/ui/*": ["./node_modules/adminizer/ui/components/ui/*"]
    }
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "lib": ["esnext"],
  "exclude": [
    "node_modules",
    "src",
    "cloud-panel/**",
    "adminizer/**"
  ],
  "include": [
    "index.ts",
    "config/**/*.ts",
    "devtools/environments.ts",
    "seeds/**/*.ts",
    "layers/app-agentiz/**/*.ts",
    "layers/app-agentiz/**/*.tsx",
    "layers/app-agentiz-gitlab-integration/**/*.ts",
    "layers/app-agentiz-gitlab-integration/**/*.tsx",
    "layers/app-agentiz-github-integration/**/*.ts",
    "layers/app-agentiz-github-integration/**/*.tsx",
    "layers/app-agentiz-mobile-api/**/*.ts",
    "layers/app-agentiz-claude-limits/**/*.ts",
    "vite.config.ts"
  ]
}
