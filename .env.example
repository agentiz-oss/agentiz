# Example environment configuration
PORT=17280
NODE_ENV=production

# Agentiz scheduler. It is disabled unless explicitly enabled.
AGENTIZ_SYNC_ENABLED=false
AGENTIZ_SYNC_CRON=*/10 * * * *

# GitLab integration layer: repository + issue sync of every linked repository.
AGENTIZ_GITLAB_SYNC_ENABLED=false
AGENTIZ_GITLAB_SYNC_CRON=*/15 * * * *
# Origin used to build the OAuth callback URL. Required behind a proxy or when the
# GitLab application is registered with a fixed redirect URI.
# AGENTIZ_PUBLIC_URL=https://agentiz.example.com

# Worker API for external (remote) workers. Enabled by default. Set this to false to
# have the in-process worker drain the queue instead.
AGENTIZ_WORKER_API_ENABLED=true
# Workers are created in the admin panel (Agentiz → Воркеры → «Новый воркер»), which issues the
# worker token once. There is no shared enrollment secret to configure here.

# Reaper that returns abandoned jobs to the queue: released ones once their backoff passes, and
# leases nobody renewed (a worker that died mid-job). Always runs, unlike the in-process worker.
# AGENTIZ_JOB_REAPER_INTERVAL_MS=15000
# AGENTIZ_JOB_MAX_ATTEMPTS=5
# AGENTIZ_JOB_RETRY_BACKOFF_MS=30000

# In-process worker. Enabled automatically when AGENTIZ_WORKER_API_ENABLED is false.
# AGENTIZ_LOCAL_WORKER_ENABLED=true
# AGENTIZ_LOCAL_WORKER_ID=agentiz-local
# AGENTIZ_LOCAL_WORKER_POLL_MS=3000

# SQLite is the default. To use PostgreSQL set DB_DIALECT=postgres and configure:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=postgres
# DB_NAME=agentiz

# Push notifications for the mobile app. Entirely optional: with nothing set here no push is sent
# and /devices still records tokens, so turning it on later needs no new app release.
# PUSH_PROVIDER decides who delivers FCM tokens — "firebase" (default, this process talks to Google)
# or "gateway" (forward to a self-hosted push gateway, and keep no Firebase credentials here).
# PUSH_PROVIDER=firebase
# AGENTIZ_FCM_SERVICE_ACCOUNT=/etc/agentiz/firebase-service-account.json
# PUSH_PROVIDER=gateway
# PUSH_GATEWAY_URL=http://push-gateway:3000
# PUSH_GATEWAY_API_KEY=push_sk_...
# PUSH_GATEWAY_TIMEOUT_MS=10000

# iOS needs nothing here: the app registers an FCM token like Android does, and the APNs .p8 is
# uploaded to the Firebase console instead of to this server.

# Adminizer's notification bell. Agentiz sends a pending agent question into it under its own
# "agentiz" class, alongside the mobile push; users need the notification-agentiz permission to see
# anything. Set to false to switch the subsystem off entirely (it is marked experimental upstream).
# ADMINIZER_NOTIFICATIONS=true
